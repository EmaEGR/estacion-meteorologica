int AUTO = 0;
int MAN = 1;
int pump_relay = 10;

float temp_lote1 = 0.0;
float temp_lote2 = 0.0;
float temp_lote3 = 0.0;
float temp_lote4 = 0.0;
float temp_promedio = 0.0;    
int cant_Lotes = 4;

uint16_t presion_lote1 = 0.0;
uint16_t presion_lote2 = 0.0;
uint16_t presion_lote3 = 0.0;
uint16_t presion_lote4 = 0.0;

// Banderas para sincronizar el envío a ThingsBoard desde el Core 1 hacia el Core 0
volatile bool nuevoDatoNodo1 = false;
volatile bool nuevoDatoNodo2 = false;

volatile bool paquete_recibido = false;
TramaLoRa mensaje;

// Array para 10 registros Modbus
#define cant_Registros 30
uint16_t mapeo[cant_Registros] = {0};

void IRAM_ATTR mensajeRecibido(void) {
  paquete_recibido = true;
}

// TAREA EN SEGUNDO PLANO (Core 0): Gestión Total de Wi-Fi y ThingsBoard
// ----------------------------------------------------------------------
void tareaThingsBoard(void * pvParameters) {
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  mqttClient.setServer(THINGSBOARD_SERVER, 1883);
  mqttClient.setBufferSize(512);                               // NEW

  unsigned long ultimoIntentoMQTT = 0;

  for (;;) {
    // Conexión Wi-Fi / MQTT
    if (WiFi.status() == WL_CONNECTED) {
      if (!mqttClient.connected()) {
        unsigned long ahora = millis();
        if (ahora - ultimoIntentoMQTT > 5000) {
          ultimoIntentoMQTT = ahora;
          Serial.print("[Core 0] Conectando a ThingsBoard...");
          if (mqttClient.connect("Heltec_Maestro", TOKEN, NULL)) {
            Serial.println(" CONECTADO!");
          } else {
            Serial.printf(" Falló (rc=%d)\n", mqttClient.state());
          }
        }
      } else {
        mqttClient.loop();

        // Publicación Lote 1
        if (nuevoDatoNodo1) {
             nuevoDatoNodo1 = false;
            char payload[200];
            snprintf(payload, sizeof(payload), "{\"Nodo_Lote_1\": [{\"temperatura\": %.1f, \"presion\": %.1f}]}", temp_lote1, (float)presion_lote1);
           
            boolean publicado = mqttClient.publish("v1/gateway/telemetry", payload);
            if (!publicado) {
                Serial.println("Error: publish devolvió false (posible buffer chico)");
            }
        }

        // Publicación Lote 2
        if (nuevoDatoNodo2) {
          nuevoDatoNodo2 = false;
          String p = "{\"Nodo_Lote_2\": [{\"temperatura\": " + String(temp_lote2, 1) + "}]}";
          mqttClient.publish("v1/gateway/telemetry", (const uint8_t*)p.c_str(), p.length());
        }
      }
    }

    // Retardo esencial para alimentar el Watchdog y ceder CPU a la pila de red
    vTaskDelay(pdMS_TO_TICKS(20));
  }
}


void setup() {
  Serial.begin(115200);

  // 1. Activar alimentación de periféricos (Vext)
  pinMode(VEXT_PIN, OUTPUT);
  digitalWrite(VEXT_PIN, LOW); 
  delay(100);

  // 2. Inicializar Radio LoRa
  //int state = radio.begin(RF_FREQUENCY, 125.0, LORA_SPREADING_FACTOR, 5, 0x12, 10);
 // int state = radio.begin(RF_FREQUENCY, 125.0, LORA_SPREADING_FACTOR, 5, 0x12, 10);
  int state = radio.begin(915.0, 125.0, 10, 5, 0x12, 10);

  if (state == RADIOLIB_ERR_NONE) {
    Serial.println(" MAESTRO LISTO (915 MHz, Sync 0x12)");
    radio.setDio1Action(mensajeRecibido);
    radio.startReceive();
  } else {
    Serial.println(" Error al iniciar radio LoRa");
    while (true);
  }

  // 3. Inicializar UART2 para HMI Delta y Modbus
  SerialDelta.begin(115200, SERIAL_8N1, RX_DELTA, TX_DELTA);
  slave = Modbus(ID, SerialDelta, 0); 
  slave.start();

  // 4. Designo tarea ThingsBoard / WIFI en el Core 0 
  xTaskCreatePinnedToCore(
    tareaThingsBoard,       /* Función de la tarea */
    "Task_ThingsBoard",     /* Nombre */
    8192,                   /* Tamaño del Stack */
    NULL,                   /* Parámetro de entrada */
    1,                      /* Prioridad */
    NULL,                   /* Identificador de tarea */
    0                       /* Asignado al NÚCLEO 0 */
  );

  Serial.println(" Sistema Maestro iniciado (HMI en Core 1 | Wi-Fi en Core 0)");
}

void loop() {
  // -------------------------------------------------------------
  // PRIORIDAD 1: Atender la consulta Modbus RTU de la pantalla Delta
  // -------------------------------------------------------------
  slave.poll(mapeo, cant_Registros);

  // -------------------------------------------------------------
  // PRIORIDAD 2: Procesar paquetes LoRa entrantes
  // -------------------------------------------------------------
  if (paquete_recibido) {
    paquete_recibido = false;
    
    int state = radio.readData((uint8_t*)&mensaje, sizeof(TramaLoRa));
    float rssi = radio.getRSSI();  // Nivel de Señal
    float snr = radio.getSNR(); // Relacion de señal/ruido
    
    if (state == RADIOLIB_ERR_NONE) { 
      if (mensaje.idDestino == ID_MAESTRO) {
        float temperatura_calculada = mensaje.temperatura / 10.0;
        float presion_calculada = mensaje.presionAtmosferica;

        switch (mensaje.idOrigen) {
          case 1: {
            temp_lote1 = temperatura_calculada;
            presion_lote1 = (int16_t)presion_calculada;
            //Serial.printf("-- Paquete ESCLAVO 1 -- Temp: %.1f °C\n", temp_lote1);
            Serial.printf("📡 [NODO 1] Temp: %.1f °C | Presion: %.1f °hPa | RSSI: %.1f dBm | SNR: %.2f dB\n", temp_lote1, presion_lote1, rssi, snr);
            nuevoDatoNodo1 = true; // Notifica a la tarea del Core 0 para enviar por MQTT
            break;
          }
          case 2: {
            temp_lote2 = temperatura_calculada;
            presion_lote2 = 1000.0;
            //Serial.printf("-- Paquete ESCLAVO 2 -- Temp: %.1f °C\n", temp_lote2);
             Serial.printf("📡 [NODO 1] Temp: %.1f °C | RSSI: %.1f dBm | SNR: %.2f dB\n", temp_lote2, rssi, snr);
            nuevoDatoNodo2 = true; // Notifica a la tarea del Core 0 para enviar por MQTT
            break;
          }
          default:
            Serial.println(" ID de mensaje desconocido");
            break;
        }
      }
    }

    // Volver a poner el radio en escucha
    radio.startReceive();
  }

  // -------------------------------------------------------------
  // PRIORIDAD 3: Actualizar registros y lógica de control
  // -------------------------------------------------------------
  updateHMI();
}

void updateHMI() {
    // Asignación de temperatura a los registros Modbus
  mapeo[7] = (int16_t)(presion_lote1 * 10);
  mapeo[9] = (int16_t)(temp_lote1 * 10);

  //Pruebas -> Carga de datos por pantalla 
  temp_lote2 = (int16_t)mapeo[5];
  presion_lote2 = mapeo[6];

  temp_lote3 = (int16_t)mapeo[10];
  presion_lote3 = mapeo[11];

  //Actualizacion promedio temperatura
  temp_promedio = (temp_lote1 + temp_lote2 + temp_lote3 + temp_lote4) /cant_Lotes;
  mapeo[14] = (int16_t)temp_promedio;


  // Evaluar condición de alarma
  if (temp_lote1 < -15 || temp_lote2 < -15) { 
    bitWrite(mapeo[4], 3, 1);
    bitWrite(mapeo[4], 4, 0);
    bitWrite(mapeo[4], 5, 0);
  } else if ((temp_lote1 >= -15 && temp_lote1 < 0) || (temp_lote2 >= -15 && temp_lote2 < 0)) {
    bitWrite(mapeo[4], 4, 1);
    bitWrite(mapeo[4], 3, 0);
    bitWrite(mapeo[4], 5, 0);
  } else {
    bitWrite(mapeo[4], 5, 1); 
    bitWrite(mapeo[4], 4, 0);
    bitWrite(mapeo[4], 3, 0);
  }

  // Actualización de Modo AUTO / MAN desde HMI
  if (bitRead(mapeo[0], 1)) {
    AUTO = 1; MAN = 0;
  }
  if (bitRead(mapeo[0], 2)) {
    AUTO = 0; MAN = 1;
  }
  bitWrite(mapeo[3], 6, AUTO);
  bitWrite(mapeo[3], 7, MAN);

  // Control de Bomba en AUTOMÁTICO
  if ((temp_lote1 < -15 || temp_lote2 < -15) && AUTO) {
    bitWrite(mapeo[3], 1, 1);
    digitalWrite(pump_relay, HIGH);
  } else if (AUTO) {
    bitWrite(mapeo[3], 1, 0);
    digitalWrite(pump_relay, LOW);
  }

  // Control de Bomba en MANUAL
  if (MAN) {
    if (bitRead(mapeo[0], 3)) {
      bitWrite(mapeo[3], 1, 1);
      digitalWrite(pump_relay, HIGH);
    }
    if (bitRead(mapeo[0], 4)) {
      bitWrite(mapeo[3], 1, 0);
      digitalWrite(pump_relay, LOW);
    }
  }
  // Control VALVE XV-001
  if (MAN) {
    if (bitRead(mapeo[0], 6)) {
      bitWrite(mapeo[3], 2, 1);
      digitalWrite(pump_relay, HIGH);
    }
    if (bitRead(mapeo[0], 7)) {
      bitWrite(mapeo[3], 2, 0);
    //  digitalWrite(pump_relay, LOW);
    }
  }

  // Control VALVE XV-002
  if (MAN) {
    if (bitRead(mapeo[0], 8)) {
      bitWrite(mapeo[3], 3, 1);
     // digitalWrite(pump_relay, HIGH);
    }
    if (bitRead(mapeo[0], 9)) {
      bitWrite(mapeo[3], 3, 0);
    //  digitalWrite(pump_relay, LOW);
    }
  }

  // Control VALVE XV-003
  if (MAN) {
    if (bitRead(mapeo[1], 0)) {
      bitWrite(mapeo[3], 4, 1);
      digitalWrite(pump_relay, HIGH);
    }
    if (bitRead(mapeo[1], 1)) {
      bitWrite(mapeo[3], 4, 0);
    //  digitalWrite(pump_relay, LOW);
    }
  }

   // Control VALVE XV-004
  if (MAN) {
    if (bitRead(mapeo[1], 2)) {
      bitWrite(mapeo[3], 5, 1);
      digitalWrite(pump_relay, HIGH);
    }
    if (bitRead(mapeo[1], 3)) {
      bitWrite(mapeo[3], 5, 0);
     // digitalWrite(pump_relay, LOW);
    }
  }
}
